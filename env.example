# LogiFlow CS Console — 환경변수 예시
# 이 파일을 .env 로 복사하고 값을 채워주세요. (절대 .env 를 저장소에 커밋하지 마세요)

# ── 데이터베이스 (Supabase Postgres) ─────────────────────────────
# Supabase 대시보드 > Project Settings > Database > Connection string
# "Transaction pooler" URI 사용 권장 (포트 6543). 예:
# postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── 세션 서명 · 정산정보 암호화 키 ────────────────────────────────
# 새로 생성: openssl rand -base64 48
JWT_SECRET=

# ── 대리점 가입 게이트 (선택) ─────────────────────────────────────
# 값을 설정하면 대리점 대표 가입 시 코드 검증을 요구하도록 백엔드가 준비되어 있습니다.
# 현재 프런트엔드 입력란은 미구현이므로, 시범 운영에서는 비워두세요(자유 가입).
AGENCY_SIGNUP_CODE=
# 이 로그인 아이디로 가입한 계정에 관리자(admin) 권한을 부여 (선택)
ADMIN_LOGIN_ID=

# ── 파일 저장소 (Supabase Storage S3 호환) ────────────────────────
# Supabase 대시보드 > Project Settings > Storage 에서 S3 접속정보 확인
# Endpoint 예: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 서버 ─────────────────────────────────────────────────────────
PORT=3000
